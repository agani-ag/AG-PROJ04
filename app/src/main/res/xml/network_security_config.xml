<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only. To test against a local http dev API, add a domain-config
         with cleartextTrafficPermitted="true" for your dev host only. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
