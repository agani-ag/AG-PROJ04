<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext (http://) is allowed so the in-app WebView can browse plain-http pages like a
         normal browser. https pages stay protected from insecure sub-resources by the WebView's
         mixedContentMode = MIXED_CONTENT_NEVER_ALLOW (see WebViewActivity.configureWebView). -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Debug builds only: trust user-installed CAs so a proxy (e.g. HTTP Toolkit) can
         decrypt this app's HTTPS while developing. Android ignores this block entirely in
         release builds, so it never ships. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
